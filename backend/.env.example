# ── Chat Model ────────────────────────────────────────────────────────────────
# Provider: ark (default) | openai | deepseek | qwen | zhipu | custom
LLM_PROVIDER=ark

# ARK keeps backward compatibility with existing deployments.
ARK_API_KEY=your_api_key_here
ARK_MODEL_ID=ep-20250211103006-s67q4

# Enable one provider block instead of ARK when needed:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=your_model_name

# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_api_key_here
# DEEPSEEK_MODEL=your_model_name

# LLM_PROVIDER=qwen
# DASHSCOPE_API_KEY=your_api_key_here
# QWEN_MODEL=your_model_name
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM_PROVIDER=zhipu
# ZAI_API_KEY=your_api_key_here
# ZHIPU_MODEL=your_model_name

# Any other OpenAI-compatible service:
# LLM_PROVIDER=custom
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=your_model_name
# LLM_BASE_URL=https://provider.example.com/v1

# Vision defaults to the chat provider. Override with a vision-capable model or
# a separate compatible provider when the chat model cannot accept images.
# VISION_PROVIDER=ark
# VISION_API_KEY=your_api_key_here
# VISION_MODEL=your_vision_model_name
# VISION_BASE_URL=https://provider.example.com/v1

# ── RAG — Embedding Backend ───────────────────────────────────────────────────
# Provider: huggingface (default, local, ~90MB) | openai | ark
EMBEDDING_PROVIDER=huggingface
# Model name (provider-specific):
#   huggingface: BAAI/bge-small-zh-v1.5  (default)
#   openai:      text-embedding-3-small
#   ark:         doubao-embedding-large-text-240915
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── RAG — Vector Store Backend ────────────────────────────────────────────────
# Backend: chroma (default) | faiss | qdrant | pgvector
VECTOR_STORE=chroma

# Chroma (default — file-based, no server required)
CHROMA_PERSIST_DIR=rag/chroma_db

# FAISS (in-memory + disk, fast, no server)
# VECTOR_STORE=faiss
# FAISS_INDEX_PATH=rag/faiss_index

# Qdrant (production-grade, requires Qdrant server)
# VECTOR_STORE=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# pgvector (PostgreSQL extension)
# VECTOR_STORE=pgvector
# PGVECTOR_CONNECTION_STRING=postgresql://user:password@localhost:5432/dbname

# ── Observability (optional) ──────────────────────────────────────────────────
# Provider: none (default) | otel | langsmith
OBSERVABILITY_PROVIDER=none

# Open-source tracing via OpenTelemetry/OpenInference. The default endpoint is
# compatible with compose.observability.yml (Jaeger UI: http://localhost:16686).
# OBSERVABILITY_PROVIDER=otel
# OTEL_SERVICE_NAME=smart-health-assistant
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Medical text and images are excluded from spans by default. Enabling text
# does not enable images; each requires an explicit opt-in.
TRACE_CONTENT=false
TRACE_IMAGES=false

# Existing LangSmith deployments remain supported.
# OBSERVABILITY_PROVIDER=langsmith
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=bigh-health-assistant
# LANGSMITH_TRACING=true
# Legacy LANGCHAIN_API_KEY / LANGCHAIN_PROJECT names are also accepted.

# ── Evaluation (optional) ─────────────────────────────────────────────────────
# Provider: local (default) | deepeval
EVAL_PROVIDER=local
# Keep DeepEval's anonymous product telemetry disabled for medical workloads.
DEEPEVAL_TELEMETRY_OPT_OUT=1
